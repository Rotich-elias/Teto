APP_NAME="Teto Technologies"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Nairobi
APP_URL=http://localhost:8000
APP_FORCE_HTTPS=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker Compose overrides DB_HOST with "mysql".
# For a local MySQL instance, create the database and user first (see README).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=teto
DB_USERNAME=teto
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production when the site is served over HTTPS.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local development: write emails to storage/logs/laravel.log.
# Production: switch to smtp and fill in the credentials below.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# TODO(owner): required in production. Must be an address on a domain you can
# send from (e.g. enquiries@teto.co.ke). When blank, auto-replies cannot be
# delivered and the failure is logged; the enquiry is still stored.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# TODO(owner): inbox that receives contact-form notifications. When blank, no
# company notification is sent (a warning is logged); the enquiry is still stored.
MAIL_TO=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Teto Technologies company details
# -----------------------------------------------------------------------------
# TODO(owner): fill these in before launch. Leave blank to show a clearly
# marked TODO(owner) placeholder on the site instead of inventing details.

TETO_EMAIL=
TETO_PHONE=
# WhatsApp number in international format without "+", e.g. 254712345678
TETO_WHATSAPP=
TETO_WHATSAPP_MESSAGE="Hello Teto Technologies, I would like to discuss a project."
TETO_ADDRESS=
TETO_HOURS=
TETO_FOUNDED=
TETO_LEGAL_NAME=
TETO_REG_NUMBER=
# Google Maps embed URL (use the src from the "Embed a map" iframe).
TETO_MAP_EMBED_URL=

TETO_LINKEDIN=
TETO_GITHUB=
TETO_X=
TETO_FACEBOOK=
TETO_INSTAGRAM=
TETO_TIKTOK=

# -----------------------------------------------------------------------------
# Cloudflare Turnstile (optional spam protection)
# -----------------------------------------------------------------------------
# The honeypot and per-IP rate limit work without this. Enable it if bots get
# through; both keys are required when TURNSTILE_ENABLED=true.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

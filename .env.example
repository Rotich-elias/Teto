# ---------------------------------------------------------------------------
# Teto Technologies — environment variables
#
# Copy to `.env.local` for local development (Next.js loads it automatically).
# In production set these in the Vercel dashboard (or your host's env settings).
# ---------------------------------------------------------------------------

# Public site origin, used for canonical URLs, sitemap, robots and JSON-LD.
# Production: https://teto.co.ke. For local development, override in .env.local
# with http://localhost:3000.
NEXT_PUBLIC_SITE_URL="https://teto.co.ke"

# --- Company details -------------------------------------------------------
# Blank values render a visible TODO(owner) badge instead of inventing data,
# except blank social URLs, which hide the icons.
TETO_EMAIL="tetoteknologies@gmail.com"
TETO_PHONE="0721 237 811"
TETO_WHATSAPP=254721237811
TETO_WHATSAPP_MESSAGE="Hello Teto Technologies, I would like to discuss a project."
TETO_ADDRESS="Westlands, Nairobi, Kenya"
TETO_HOURS="Open 24/7"
TETO_FOUNDED="2019"
TETO_LEGAL_NAME="Teto Technologies"
TETO_REG_NUMBER="Tech20261"
TETO_FOUNDER="Rotich Elias"
TETO_MAP_EMBED_URL="https://www.google.com/maps?q=Westlands,+Nairobi,+Kenya&output=embed"
# Privacy/data-request contact. Falls back to TETO_EMAIL when blank.
TETO_DATA_EMAIL="tetoteknologies@gmail.com"
# TikTok is supplied. The other social URLs are intentionally blank; blank
# values hide the social icons instead of showing a badge.
TETO_LINKEDIN=
TETO_GITHUB=
TETO_X=
TETO_FACEBOOK=
TETO_INSTAGRAM=
TETO_TIKTOK="https://www.tiktok.com/@teto_technologies"

# --- Contact form email (Resend) -------------------------------------------
# Create a key at https://resend.com/api-keys. Without it the form still
# accepts submissions but sends no email (a warning is logged).
RESEND_API_KEY=
# Comma-separated notification recipients. Both receive new enquiries.
CONTACT_TO_EMAIL="tetoteknologies@gmail.com, elgeiy8@gmail.com"
# Verified sender. Falls back to Resend's onboarding address in development.
CONTACT_FROM_EMAIL="Teto Technologies <onboarding@resend.dev>"

# --- Contact form storage (Neon Postgres) ----------------------------------
# Connection string from https://neon.tech. Without it submissions are emailed
# but not stored. Run `npm run db:migrate` after setting this.
DATABASE_URL=

# --- Cloudflare Turnstile (optional bot protection) ------------------------
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
